# Primary AI provider
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Secondary AI provider (fallback)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Tertiary AI provider (final fallback)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5

# Estimated AI cost rates in paise per 1 million tokens.
# Based on official USD pricing converted with AI_COST_USD_TO_INR.
AI_COST_USD_TO_INR=94.3
AI_COST_DEEPSEEK_CACHE_HIT_PAISE_PER_1M=264
AI_COST_DEEPSEEK_CACHE_MISS_PAISE_PER_1M=1320
AI_COST_DEEPSEEK_INPUT_PAISE_PER_1M=1320
AI_COST_DEEPSEEK_OUTPUT_PAISE_PER_1M=2640
AI_COST_GROQ_INPUT_PAISE_PER_1M=5564
AI_COST_GROQ_OUTPUT_PAISE_PER_1M=7450
AI_COST_ANTHROPIC_INPUT_PAISE_PER_1M=9430
AI_COST_ANTHROPIC_OUTPUT_PAISE_PER_1M=47150

# Server
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://yoursite.com
APP_URL=https://yoursite.com

# Razorpay payment
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Access token signing key — required in production; use a long random string
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=generate-a-strong-random-secret-here
ADMIN_ACCESS_TOKEN=generate-a-different-strong-admin-token-here

# SQLite database file path
# Development: relative path is fine
# Production: set to a persistent disk mount so data survives redeployments
DATABASE_PATH=./database.sqlite
# DATABASE_PATH=/mnt/data/database.sqlite

# Email — SMTP settings for payment confirmation emails
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=ResumeAlignAI <your_gmail@gmail.com>
